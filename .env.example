# ChainGuard environment. Copy to .env for `npm run dev:api`; put local overrides in .env.local.
# docker compose sets its own database, Redis, sandbox and JWT settings and reads only the
# LOG_LEVEL, SANDBOX_FORK_URL, LIVE_* and GUARDIAN_PRIVATE_KEY values from .env.
# Never commit real values: .env is git-ignored.

# ---------------------------------------------------------------------------
# API server (apps/api)
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Render injects PORT automatically
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# all = HTTP API + stream consumer + watchers in one process (Render free tier);
# api / watcher run the halves separately.
ROLE=all
# Comma-separated browser origins allowed to call the API (localhost is always allowed outside production)
CORS_ORIGINS=http://localhost:3000
# HMAC key for session tokens, at least 32 characters. Render generates one from render.yaml.
JWT_SECRET=dev-only-change-me-dev-only-change-me

# PostgreSQL. Neon: use the pooled connection string with ?sslmode=require
DATABASE_URL=postgres://chainguard:chainguard@localhost:5432/chainguard
# Redis. Upstash: the rediss:// URL (TLS)
REDIS_URL=redis://localhost:6379
# Redis Stream carrying watcher → API events, its consumer group, approximate max length,
# and how long one XREADGROUP blocks (longer = fewer commands on Upstash's free tier)
STREAM_KEY=chainguard:events
STREAM_GROUP=api
STREAM_MAXLEN=5000
STREAM_BLOCK_MS=20000

# Seed the demo account + a historical incident, and enable POST /auth/demo
SEED_DEMO=true
DEMO_EMAIL=demo@chainguard.dev

# ---------------------------------------------------------------------------
# Sandbox chain (anvil) behind "Simulate attack"
# ---------------------------------------------------------------------------
SANDBOX_ENABLED=true
SANDBOX_RPC_URL=http://127.0.0.1:8545
SANDBOX_WS_URL=ws://127.0.0.1:8545
# true = the API starts anvil itself (Render); false = anvil runs elsewhere (docker compose)
SANDBOX_ANVIL_SPAWN=true
# Path to the anvil binary when spawning
ANVIL_PATH=anvil
# Optional: an RPC URL to fork (e.g. Sepolia) instead of starting from an empty chain
SANDBOX_FORK_URL=
# Seconds per block; the guardian has roughly this long to front-run an attack
SANDBOX_BLOCK_TIME=2
# anvil's public dev mnemonic. These keys are worthless outside the local sandbox chain.
SANDBOX_MNEMONIC=test test test test test test test test test test test junk

# ---------------------------------------------------------------------------
# Detection rules
# ---------------------------------------------------------------------------
# Score (0-100) at or above which a withdrawal triggers the guardian's pause()
PAUSE_THRESHOLD=70
# A withdrawal of at least this share of the vault balance is "large" (basis points; 1000 = 10%)
LARGE_WITHDRAWAL_BPS=1000
# N calls from one sender within the window count as rapid repeats
RAPID_REPEAT_COUNT=3
RAPID_REPEAT_WINDOW_SEC=60

# ---------------------------------------------------------------------------
# Live monitoring on Sepolia
# ---------------------------------------------------------------------------
# off | mock (scripted traffic, no keys needed) | alchemy (real mempool via Alchemy)
LIVE_PROVIDER=off
# Alchemy Sepolia WebSocket URL: wss://eth-sepolia.g.alchemy.com/v2/<key>
ALCHEMY_WS_URL=
# Alchemy Sepolia HTTPS URL (vault state reads, guardian transactions)
SEPOLIA_RPC_URL=
# Address printed by `forge script script/Deploy.s.sol`
LIVE_VAULT_ADDRESS=
# Comma-separated addresses that normally operate the vault (admin, ops withdrawers…)
LIVE_KNOWN_CALLERS=
# SECRET. Private key of the account holding GUARDIAN_ROLE on the Sepolia vault.
# Use a dedicated key funded with a little Sepolia ETH. Without it the watcher only alerts.
GUARDIAN_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Dashboard (apps/web), read at build time
# ---------------------------------------------------------------------------
# Public URL of the API (the Render service URL in production)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Contract deployment (packages/contracts), read by script/Deploy.s.sol
# ---------------------------------------------------------------------------
# Sepolia RPC and Etherscan key for `forge script ... --verify`
ETHERSCAN_API_KEY=
VAULT_ADMIN=
VAULT_GUARDIAN=
# Comma-separated
VAULT_WITHDRAWERS=
# Defaults: 0.05 ETH per hour, 1 hour timelock
VAULT_WITHDRAW_LIMIT_WEI=50000000000000000
VAULT_WINDOW_SECONDS=3600
VAULT_TIMELOCK_SECONDS=3600
# Optional initial deposit from the deployer
VAULT_SEED_WEI=0

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Integration tests (apps/api) and the Playwright smoke test use these
TEST_DATABASE_URL=postgres://chainguard:chainguard@localhost:5432/chainguard
TEST_REDIS_URL=redis://localhost:6379
# Only behind a TLS-intercepting proxy: CA bundle passed to docker builds
EXTRA_CA_CERT=
