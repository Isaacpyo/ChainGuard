{
  "name": "chainguard",
  "private": true,
  "description": "Real-time smart contract security monitoring: mempool watcher, rules engine, auto-pause guardian and dashboard.",
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev:api": "npm run dev -w @chainguard/api",
    "dev:web": "npm run dev -w @chainguard/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:contracts": "cd packages/contracts && forge test",
    "test:e2e": "playwright test",
    "abi": "node packages/contracts/script/export-abi.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "^7.3.7"
  }
}
